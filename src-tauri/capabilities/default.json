{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default permissions for Rove",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "drag:default",
    { "identifier": "opener:allow-open-path", "allow": [{ "path": "**" }] }
  ]
}