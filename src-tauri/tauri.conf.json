{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rove Explorer",
  "version": "0.4.4",
  "identifier": "com.roveexplorer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Rove Explorer", "width": 1240, "height": 800, "minWidth": 760, "minHeight": 560 }],
    "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "resources": ["icons/32x32.png"] }
}